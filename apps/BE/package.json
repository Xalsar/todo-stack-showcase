{
  "name": "BE",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:up": "podman-compose -f compose.yaml up -d",
    "db:down": "podman-compose -f compose.yaml down",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "client:generate": "orval",
    "seed": "tsx --env-file=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "orval": "^8.24.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
