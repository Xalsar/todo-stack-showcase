{
  "name": "todo-stack-showcase",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k --kill-signal=SIGTERM -n BE,FE -c auto \"pnpm --filter BE dev\" \"pnpm --filter FE dev\"",
    "be:dev": "pnpm --filter BE dev",
    "fe:dev": "pnpm --filter FE dev",
    "be:build": "pnpm --filter BE build",
    "be:typecheck": "pnpm --filter BE typecheck",
    "fe:build": "pnpm --filter FE build",
    "fe:typecheck": "pnpm --filter FE typecheck",
    "be:start": "pnpm --filter BE start",
    "fe:start": "pnpm --filter FE start",
    "be:db:up": "pnpm --filter BE db:up",
    "be:db:down": "pnpm --filter BE db:down",
    "be:migrate": "pnpm --filter BE migrate",
    "be:migrate:name": "pnpm --filter BE migrate:name",
    "be:generate": "pnpm --filter BE generate",
    "be:studio": "pnpm --filter BE studio",
    "be:seed": "pnpm --filter BE seed",
    "be:openapi": "pnpm --filter BE openapi",
    "be:api-client": "pnpm --filter BE client:generate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:be": "vitest run --project BE",
    "test:fe": "vitest run --project FE",
    "e2e": "pnpm --filter E2E e2e",
    "test:e2e": "pnpm --filter E2E e2e",
    "e2e:ui": "pnpm --filter E2E e2e:ui",
    "e2e:install": "pnpm --filter E2E e2e:install",
    "e2e:db:create": "podman exec todo-pg psql -U todos -d todos -tAc \"SELECT 1 FROM pg_database WHERE datname='todos_e2e'\" | grep -q 1 || podman exec todo-pg psql -U todos -d todos -c \"CREATE DATABASE todos_e2e\"",
    "e2e:db:migrate": "DATABASE_URL=\"postgresql://todos:devpass@localhost:5432/todos_e2e?schema=public\" pnpm --filter BE exec prisma migrate deploy",
    "e2e:seed": "DATABASE_URL=\"postgresql://todos:devpass@localhost:5432/todos_e2e?schema=public\" pnpm --filter BE e2e:seed",
    "e2e:setup": "pnpm e2e:db:create && pnpm e2e:db:migrate && pnpm e2e:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
