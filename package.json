  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "be:dev": "pnpm --filter BE dev",
    "fe:dev": "pnpm --filter FE dev",
    "be:build": "pnpm --filter BE build",
    "fe:build": "pnpm --filter FE build",
    "be:start": "pnpm --filter BE start",
